{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumi-memory-museum",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lumi-memory-museum",
    "database_id": "75f016bd-3bd8-4f5a-abcd-97ee58358c41"
  }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "lumi-memory-museum" }],
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": { "enabled": false }
}
